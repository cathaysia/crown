diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6b51ac6..36eb6f4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -430,6 +430,23 @@ if(CRYPTO_BACKEND STREQUAL "WinCNG" OR NOT CRYPTO_BACKEND)
   endif()
 endif()
 
+# Crown backend, provided out-of-tree by the parent project (no find_package
+# module). Kept last so an automatic selection still prefers the backends
+# above, in their existing order.
+
+if(CRYPTO_BACKEND STREQUAL "Crown" OR
+   (NOT CRYPTO_BACKEND AND NOT "${CROWN_LIBRARIES}" STREQUAL ""))
+
+  if("${CROWN_LIBRARIES}" STREQUAL "")
+    message(FATAL_ERROR "Crown crypto backend selected, but CROWN_LIBRARIES is empty")
+  endif()
+
+  set(CRYPTO_BACKEND "Crown")
+  set(CRYPTO_BACKEND_DEFINE "LIBSSH2_CROWN")
+  list(APPEND LIBSSH2_LIBS ${CROWN_LIBRARIES})
+  include_directories(${CROWN_INCLUDE_DIRS})
+endif()
+
 # Global functions
 
 # Convert GNU Make assignments into CMake ones.
